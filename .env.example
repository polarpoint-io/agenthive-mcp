# AgentHive service and your personal token (all required)
# See https://github.com/polarpoint-io/agenthive/blob/main/ONBOARDING.md
AGENTHIVE_URL=https://your-agenthive-host
AGENTHIVE_TOKEN=your_personal_token_here
AGENTHIVE_TEAM_ID=your_team_id_here

# Transport: 'stdio' (default, for MCP clients) or 'http' (for HTTP/SSE)
TRANSPORT=stdio

# HTTP transport settings (only used when TRANSPORT=http)
HTTP_HOST=0.0.0.0
HTTP_PORT=8000

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
