@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()
title agenthive-mcp - Container Diagram

Person(engineer, "Engineer", "Runs a coding-agent session in Claude Code, VS Code or Cursor")

System_Boundary(harness, "Agent Harness") {
  Container(model, "Agent Loop", "The model and its tool calls", "Decides what to do. Everything it can reach arrives through the tool list")
  Container(lifecycle, "Lifecycle Hooks", "Commands the harness spawns", "Run OUTSIDE the agent loop, on session start, tool results and session end. Cannot call an MCP tool, so they need their own route")
}

System_Boundary(pkg, "agenthive-mcp (one package, four entry points)") {
  Container(mcp, "agenthive-mcp", "FastMCP over stdio or HTTP/SSE", "Member-role tools: retrieve_context, retrieve_index, fetch_nodes, report_gaps, confirm_memory, log_session. ~378 tokens of definitions, down from ~1130 - every one is sent on every request. Setup helpers are behind a flag, off by default")
  Container(hook, "agenthive-hook", "Python, one implementation", "Injects known facts at session start, learns a fact when a failing command is replaced by a working one, watches for turns repeating the same failure, pools tool-usage evidence. Claude Code and VS Code share a format; Cursor's events are translated")
  Container(log, "agenthive-log", "Python", "The session-end backstop: records that a session ended without logging, so the gap is visible rather than silent")
  Container(cli, "agenthive", "Python CLI", "status, facts, toolprune, doctor - from a terminal, where asking costs nothing")
  ContainerDb(state, "Local State", "Files under XDG_STATE_HOME", "Repeated-failure counts, loop fingerprints, send claims and the marker saying a real log_session already happened")
}

System_Ext(agenthive, "AgentHive", "The shared, reviewed memory graph. Holds the approval gate, team isolation and the role split - this package decides nothing of its own")

Rel(engineer, model, "Works with")
Rel(model, mcp, "Calls tools", "MCP")
Rel(lifecycle, hook, "Spawns with event JSON on stdin")
Rel(lifecycle, log, "Spawns at session end")
Rel(engineer, cli, "Inspects and overrides")
Rel(mcp, agenthive, "Pass-through, caller's own token", "HTTPS/JSON")
Rel(hook, agenthive, "Facts in, tool usage out", "HTTPS/JSON")
Rel(log, agenthive, "Records an unsummarised session", "HTTPS/JSON")
Rel(hook, state, "Counts failures, fingerprints loops")
Rel(mcp, state, "Marks a successful log_session")

@enduml
